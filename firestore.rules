rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Daily discretionary expenses. Every document is scoped to the user
    // that created it via a `userId` field.
    match /expenses/{expenseId} {
      allow read, update, delete: if isOwner(resource.data.userId);
      allow create: if isOwner(request.resource.data.userId);
    }

    // Fixed liabilities / recurring bills, same ownership model as expenses.
    match /mandatory_expenses/{billId} {
      allow read, update, delete: if isOwner(resource.data.userId);
      allow create: if isOwner(request.resource.data.userId);
    }

    // Per-user settings (currently just saved monthly income), keyed by uid.
    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }

    // Deny anything not explicitly matched above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
